---
const currentYear = new Date().getFullYear();
const apiUrl = import.meta.env.PUBLIC_API_URL;
---

<footer
  class="rounded-lg shadow m-4 bg-black/5 dark:bg-black/20 backdrop-blur-lg w-full mx-auto container lg:max-w-4xl md:max-w-2xl mb-10 flex justify-center max-sm:p-4"
>
  <div
    class="w-full max-w-screen-xl mx-auto md:flex md:items-center md:justify-between"
  >
    <span class="text-sm sm:text-center text-zinc-800/90 dark:text-zinc-200/90"
      >© {currentYear}
      {" "}
      <button
        aria-label="Boton inicio"
        id="button-home"
        type="button"
        class="hover:underline"
      >
        CescDev.
      </button>
      Casi todos los derechos reservados.
    </span>
    <ul
      class="flex flex-wrap gap-x-8 md:gap-x-4 items-center mt-3 text-sm font-medium dark:text-white/90 sm:mt-0"
    >
      <li>
        <a
          href="https://api.whatsapp.com/send?phone=50575437011&text=%C2%A1¡Hola! Vi tu portafolio web y me interesa contratarte para un proyecto. ¿Tienes disponibilidad?"
          class="hover:underline">Contáctame</a
        >
      </li>

      <li>
        <a href="mailto:cesarurroz.dev@gmail.com" class="hover:underline"
          >Contacto</a
        >
      </li>

      <li>
        <a href="/#sobre-mi" class="hover:underline me-4 md:me-6">Sobre mí</a>
      </li>
    </ul>
  </div>
</footer>

<script>
  const buttonSubir = document.querySelector("#button-home");

  buttonSubir?.addEventListener("click", () => {
    window.scrollTo({
      top: 0,
      behavior: "smooth",
    });
    window.history.pushState({}, "", "/");
  });
</script>
