---
const personalImageAlt = "César Urroz";
import Badge from "../components/Badge.astro";
import LinkedInIcon from "../components/icons/iconsSocials/LinkedIn.astro";
import GitHub from "../components/icons/iconsSocials/GitHub.astro";
import SocialPill from "../components/SocialPill.astro";
import Mail from "./icons/iconsSocials/Mail.astro";
import SparklesIcon from "./icons/SparklesIcon.astro";
import WhatsApp from "./icons/iconsSocials/WhatsApp.astro";
---

<div class="max-w-xl">
  <div class="gap-4 mb-4">
    <div class="flex items-center justify-start gap-x-6">
      <img
        class="rounded-full shadow-lg size-20 object-cover"
        src="/img/foto-perfil.webp"
        alt={personalImageAlt}
        style="object-position: top center"
      />
      <a
        href="https://www.linkedin.com/in/c%C3%A9sar-urroz-0289aa240"
        target="_blank"
        rel="noopener noreferrer"
        style="object-position: top center"
        class="flex items-center transition md:justify-center md:hover:scale-105"
      >
        <Badge>
          <SparklesIcon class="size-3" /> Disponible para trabajar
        </Badge>
      </a>
    </div>

    <h1
      class="text-4xl font-bold tracking-tight text-gray-800 sm:text-5xl dark:text-white"
    >
      Hola, soy César Urroz
    </h1>
    <p
      class="mt-3 text-xl text-gray-800 dark:[&>strong]:text-yellow-200 [&>strong]:text-cyan-900 [&>strong]:font-semibold dark:text-gray-300"
    >
      +2 años de experiencia.
      <strong> Ingeniero en Sistema</strong>
      <div id="typed-strings">
        <p>
          Soy <strong class="dark:text-yellow-200 text-cyan-950 font-semibold"
            >Desarrollador de Software</strong
          >
        </p>
        <p>
          Soy <strong class="dark:text-yellow-200 text-cyan-950 font-semibold"
            >Desarrollador Web</strong
          >
        </p>
        <p>
          Yo {" "}
          <em class="text-sky-900/65 dark:text-yellow-400">trabajo</em>
          <strong class="dark:text-yellow-200 text-sky-700 font-semibold">
            {" "} con React, Next.js, Astro, TypeScript, Node.js, Express, C#...
          </strong>
        </p>
      </div>

      <div class="text-start mt-3"><span id="typed"></span></div>
    </p>

    <nav class="flex flex-wrap gap-4 mt-8">
      <SocialPill href="mailto:cesarurroz.dev@gmail.com">
        <Mail class="size-4" />
        Contáctame
      </SocialPill>
      <SocialPill
        href="https://api.whatsapp.com/send?phone=50575437011&text=%C2%A1¡Hola! Vi tu portafolio web y me interesa contratarte para un proyecto. ¿Tienes disponibilidad?"
      >
        <WhatsApp class="size-4" />
        Contáctame
      </SocialPill>
      <SocialPill href="https://www.linkedin.com/in/c%C3%A9sar-urroz-0289aa240">
        <LinkedInIcon class="size-4 dark:fill-white fill-slate-700" />
        LinkedIn
      </SocialPill>
      <SocialPill href="https://github.com/GitCesc07">
        <GitHub class="size-4" />
        GitHub
      </SocialPill>
    </nav>

    <script>
      import Typed from "typed.js";

      var typed = new Typed("#typed", {
        stringsElement: "#typed-strings",
        typeSpeed: 50,
        loop: true,
      });
    </script>
  </div>
</div>
